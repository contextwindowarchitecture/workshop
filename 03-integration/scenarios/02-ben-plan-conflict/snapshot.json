          "lineage": "verbatim",
          "injection_risk": "untrusted_content",
          "body": "Every workspace member has one role: Owner, Admin, Member or Guest. A workspace has at least one Owner. Only Owners can delete the workspace, change the plan, or transfer ownership."
        },

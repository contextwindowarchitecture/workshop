{
  "route": "consult",
  "version": "c1-consult/v1",
  "clock_skew_seconds": 5,
  "requires_evidence": true,
  "producers": {
    "clinical-policy": {
      "kind": "policy",
      "slots": [
        "governance.instructions",
        "governance.output_contract"
      ]
    },
    "ehr-chart": {
      "kind": "state",
      "slots": [
        "state.task"
      ]
    },
    "telemetry": {
      "kind": "state",
      "slots": [
        "state.task"
      ]
    },
    "clinician-state": {
      "kind": "state",
      "slots": [
        "state.user"
      ]
    },
    "ehr-notes": {
      "kind": "memory",
      "slots": [
        "interaction.memory"
      ]
    },
    "guidelines": {
      "kind": "retrieval",
      "slots": [
        "evidence.knowledge"
      ]
    },
    "ambient-scribe": {
      "kind": "interaction",
      "slots": [
        "interaction.history",
        "interaction.query"
      ]
    }
  },
  "slots": {
    "state.task": {
      "max_age_seconds": 300,
      "required_scope": [
        "tenant",
        "task"
      ]
    },
    "state.user": {
      "max_age_seconds": 300,
      "required_scope": [
        "tenant",
        "user"
      ]
    },
    "evidence.knowledge": {
      "min_relevance": 3.0,
      "min_included": 1,
      "dedupe": "exact",
      "max_per_source": 2,
      "order_by": [
        "-relevance",
        "-freshness"
      ]
    },
    "interaction.memory": {
      "source_prefix": "note:",
      "required_scope": [
        "tenant",
        "task"
      ],
      "order_by": [
        "-freshness"
      ]
    },
    "interaction.history": {
      "required_scope": [
        "session"
      ],
      "order_by": [
        "-freshness"
      ],
      "max_tokens": 900
    },
    "interaction.query": {
      "required_scope": [
        "session"
      ]
    }
  },
  "tier_upgrades": {
    "state.user": "protected"
  },
  "facts": {
    "vitals.bp": {
      "precedence": [
        "telemetry",
        "ehr-notes"
      ],
      "scope": [
        "tenant"
      ],
      "on_unresolved": "refuse"
    }
  },
  "fitting_order": [
    {
      "slot": "interaction.history",
      "action": "omit"
    },
    {
      "slot": "interaction.memory",
      "action": "compress"
    },
    {
      "slot": "interaction.memory",
      "action": "omit"
    },
    {
      "slot": "evidence.knowledge",
      "action": "omit"
    }
  ],
  "parser": true
}

          "freshness": "2026-03-30T09:00:00Z",
          "relevance": 0.56,
          "lineage": "verbatim",
          "injection_risk": "untrusted_content",
          "body": "To cancel, the workspace owner opens Settings, then Billing, and chooses Cancel plan. To request a refund on an annual plan, contact support from the same page within the 30-day window."
        },
        {
          "token_budget": null,
          "variants": [],
          "conflict_policy": "defers",
          "eligibility": "route-policy",
          "id": "help:refunds@4#1",
          "slot": "evidence.knowledge",
          "source": "help-center:refunds",

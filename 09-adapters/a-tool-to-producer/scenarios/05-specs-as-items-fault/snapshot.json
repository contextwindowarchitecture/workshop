          "trust": "verified",
          "freshness": "2026-03-30T09:00:00Z",
          "relevance": 0.533,
          "lineage": "verbatim",
          "injection_risk": "untrusted_content",
          "body": "Monthly plans are not refunded, but you can cancel at any time. Cancellation stops the next renewal; the workspace keeps its paid features until the end of the period you have paid for, then moves to the Free plan."
        },
        {
          "token_budget": null,
          "variants": [],
          "conflict_policy": "defers",

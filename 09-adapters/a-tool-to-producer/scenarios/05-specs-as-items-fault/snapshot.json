          "relevance": 0.67,
          "lineage": "verbatim",
          "injection_risk": "untrusted_content",
          "body": "Fernway has three plans: Free, Team and Business. Every plan includes unlimited tasks, the Board, List and Timeline views, and the desktop and mobile apps."
        },
        {
          "token_budget": null,
          "variants": [],
          "conflict_policy": "defers",
          "eligibility": "route-policy",
          "id": "help:plans@9#4",
          "slot": "evidence.knowledge",
          "source": "help-center:plans",
          "source_version": "9",
          "authority": "reference_only",
          "trust": "verified",
          "freshness": "2026-09-01T00:00:00Z",
          "relevance": 0.63,
          "lineage": "verbatim",
          "injection_risk": "untrusted_content",
          "body": "Single sign-on and SCIM are not available on the Team plan. A Team workspace that needs them must upgrade to Business."
        },
        {
          "token_budget": null,
          "variants": [],
          "conflict_policy": "defers",

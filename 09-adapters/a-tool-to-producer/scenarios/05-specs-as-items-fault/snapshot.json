          "freshness": "2026-09-01T00:00:00Z",
          "relevance": 0.605,
          "lineage": "verbatim",
          "injection_risk": "untrusted_content",
          "body": "The Free plan is for up to 5 members, with 3 active projects, 1 GB of file storage and 7 days of activity history. Support is through the community forum."
        },
        {
          "token_budget": null,
          "variants": [],
          "conflict_policy": "defers",

          "source_version": "5",
          "authority": "reference_only",
          "trust": "verified",
          "freshness": "2026-07-14T12:00:00Z",
          "relevance": 0.0,
          "lineage": "verbatim",
          "injection_risk": "untrusted_content",
          "body": "When you add members mid-cycle, Fernway charges a prorated amount for the rest of the billing period. When you remove members, the unused time becomes a credit on your next invoice, not a refund."
        },
        {
          "token_budget": null,
          "variants": [],
          "conflict_policy": "defers",
          "eligibility": "route-policy",
          "id": "help:billing@5#4",
          "slot": "evidence.knowledge",
          "source": "help-center:billing",
          "source_version": "5",
          "authority": "reference_only",
          "trust": "verified",
          "freshness": "2026-07-14T12:00:00Z",
          "relevance": 0.0,
          "lineage": "verbatim",
          "injection_risk": "untrusted_content",
          "body": "You can change plans at any time. An upgrade takes effect immediately and is prorated. A downgrade takes effect at the end of the current billing period."
        },
        {
          "token_budget": null,
          "variants": [],
          "conflict_policy": "defers",
          "eligibility": "route-policy",

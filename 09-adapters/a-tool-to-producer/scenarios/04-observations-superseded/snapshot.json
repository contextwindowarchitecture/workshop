          "freshness": "2026-09-10T15:00:00Z",
          "relevance": 0.0,
          "lineage": "verbatim",
          "injection_risk": "untrusted_content",
          "body": "You can export a single project or the whole workspace. Exports include tasks, subtasks, comments, labels and assignees. Attachments are exported separately as a ZIP file."
        },
        {
          "token_budget": null,
          "variants": [],
          "conflict_policy": "defers",

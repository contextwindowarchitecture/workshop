{
  "type": "object",
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "budget": {
      "type": "object",
      "properties": {
        "input": {
          "type": "integer",
          "minimum": 0
        },
        "reserved_output": {
          "type": "integer",
          "minimum": 0
        },
        "margin_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "The snapshot's budget.margin_percent, repeated when the snapshot sets it (R-16)."
        }
      },
      "required": [
        "input",
        "reserved_output"
      ],
      "additionalProperties": false
    },
    "result": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "input_tokens": {
              "type": "integer",
              "minimum": 0
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          },
          "required": [
            "input_tokens",
            "hash"
          ],
          "additionalProperties": false
        }
      ]
    },
    "included": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "governance.instructions",
              "governance.capabilities",
              "governance.examples",
              "governance.output_contract",
              "state.user",
              "state.task",
              "evidence.knowledge",
              "evidence.tool_results",
              "interaction.memory",
              "interaction.history",
              "interaction.query"
            ]
          },
          "item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "tokens": {
            "type": "integer",
            "minimum": 0
          },
          "source_version": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "eligibility": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          }
        },
        "required": [
          "slot",
          "item_id",
          "tokens",
          "source_version",
          "eligibility"
        ],
        "additionalProperties": false
      }
    },
    "compressed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "enum": [
              "governance.instructions",
              "governance.capabilities",
              "governance.examples",
              "governance.output_contract",
              "state.user",
              "state.task",
              "evidence.knowledge",
              "evidence.tool_results",
              "interaction.memory",
              "interaction.history",
              "interaction.query"
            ]
          },
          "item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "from": {
            "type": "integer",
            "minimum": 0
          },
          "to": {
            "type": "integer",
            "minimum": 0
          },
          "method": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "variant_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          }
        },
        "required": [
          "slot",
          "item_id",
          "from",
          "to",
          "method",
          "variant_id"
        ],
        "additionalProperties": false
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "stage": {
            "type": "string",
            "enum": [
              "producer",
              "assembler"
            ]
          },
          "duplicate_of": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]",
            "description": "For duplicate_content only: the id of the item kept in its place, by the slot's dedupe on an assembler row (R-24) or by the producer on a producer row (R-13)."
          },
          "superseded_by": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]",
            "description": "For superseded only: on an assembler row, the id of the latest item kept for the same producer and source (R-25); on a producer row, the candidate the producer's report names (R-9)."
          },
          "slot": {
            "type": "string",
            "enum": [
              "governance.instructions",
              "governance.capabilities",
              "governance.examples",
              "governance.output_contract",
              "state.user",
              "state.task",
              "evidence.knowledge",
              "evidence.tool_results",
              "interaction.memory",
              "interaction.history",
              "interaction.query"
            ]
          }
        },
        "required": [
          "item_id",
          "reason",
          "stage"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "duplicate_content"
                }
              },
              "required": [
                "reason"
              ]
            },
            "then": {
              "required": [
                "duplicate_of"
              ],
              "properties": {
                "duplicate_of": true
              }
            },
            "else": {
              "not": {
                "required": [
                  "duplicate_of"
                ],
                "properties": {
                  "duplicate_of": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "reason": {
                  "const": "superseded"
                }
              },
              "required": [
                "reason"
              ]
            },
            "then": {
              "required": [
                "superseded_by"
              ],
              "properties": {
                "superseded_by": true
              }
            },
            "else": {
              "not": {
                "required": [
                  "superseded_by"
                ],
                "properties": {
                  "superseded_by": true
                }
              }
            }
          }
        ]
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
            },
            "minItems": 2,
            "uniqueItems": true
          },
          "kind": {
            "type": "string",
            "enum": [
              "instruction",
              "fact"
            ]
          },
          "resolution": {
            "type": "string",
            "enum": [
              "resolved",
              "surfaced",
              "context_requested",
              "refused",
              "moot"
            ],
            "description": "resolved when authority, policy or a freshness tie-break decided the group; surfaced, context_requested or refused when it escalated, following the route's on_unresolved action; moot when fewer than two members were admitted (R-11)."
          },
          "decided_by": {
            "type": "string",
            "enum": [
              "authority",
              "policy",
              "freshness",
              "escalated",
              "moot"
            ]
          },
          "group_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "winner": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]",
            "description": "The member that prevailed, when one did. One of items."
          }
        },
        "required": [
          "group_id",
          "kind",
          "items",
          "resolution",
          "decided_by"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "type": "object",
              "properties": {
                "decided_by": {
                  "const": "moot"
                }
              },
              "required": [
                "decided_by"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "resolution": {
                  "const": "moot"
                }
              }
            },
            "else": {
              "type": "object",
              "properties": {
                "resolution": {
                  "not": {
                    "const": "moot"
                  }
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "properties": {
                "decided_by": {
                  "const": "escalated"
                }
              },
              "required": [
                "decided_by"
              ]
            },
            "then": {
              "type": "object",
              "properties": {
                "resolution": {
                  "enum": [
                    "surfaced",
                    "context_requested",
                    "refused"
                  ]
                }
              }
            },
            "else": {
              "type": "object",
              "properties": {
                "resolution": {
                  "not": {
                    "enum": [
                      "surfaced",
                      "context_requested",
                      "refused"
                    ]
                  }
                }
              }
            }
          },
          {
            "if": {
              "type": "object",
              "required": [
                "winner"
              ],
              "properties": {
                "winner": true
              }
            },
            "then": {
              "type": "object",
              "properties": {
                "resolution": {
                  "const": "resolved"
                }
              }
            }
          }
        ]
      }
    },
    "refused": {
      "type": "object",
      "properties": {
        "bool": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "bool",
        "reason"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "spec": {
          "const": "cwa/draft",
          "description": "The specification the assembly followed, which is the profile's spec (R-21)."
        },
        "assembly_time": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[Tt]([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]+)?([Zz]|[+-]([01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
        },
        "route_policy_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        },
        "tokenizer": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        },
        "renderer": {
          "type": "string",
          "minLength": 1,
          "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
        },
        "snapshot_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "minLength": 64,
          "maxLength": 64,
          "description": "Lowercase SHA-256 of the normalized snapshot, as conformance/README.md's Snapshot digest defines it (R-22)."
        }
      },
      "required": [
        "spec",
        "assembly_time",
        "route_policy_version",
        "tokenizer",
        "renderer",
        "snapshot_digest"
      ],
      "additionalProperties": false
    },
    "defaults_filled": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
          },
          "field": {
            "type": "string",
            "enum": [
              "token_budget",
              "variants",
              "conflict_policy",
              "lineage",
              "eligibility",
              "injection_risk"
            ]
          }
        },
        "required": [
          "item_id",
          "field"
        ],
        "additionalProperties": false
      },
      "description": "One record per item and policy field filled under R-3; an empty list when none were (R-22)."
    },
    "timings": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "recovery": {
      "type": "object",
      "properties": {
        "action": {
          "enum": [
            "retrieve_narrower",
            "precompute_summary",
            "request_context"
          ]
        },
        "detail": {
          "type": "string",
          "description": "Free text for people about the recovery. No requirement defines it, and conformance never compares it (conformance/README.md, Running a case)."
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "trace_id",
    "profile",
    "budget",
    "result",
    "included",
    "compressed",
    "excluded",
    "conflicts",
    "refused",
    "context",
    "defaults_filled"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contextwindowarchitecture.io/schema/trace.schema.json",
  "title": "CWA assembly trace",
  "allOf": [
    {
      "if": {
        "properties": {
          "refused": {
            "properties": {
              "bool": {
                "const": true
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      },
      "then": {
        "properties": {
          "result": {
            "type": "null"
          },
          "refused": {
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "[^\\t\\n\\v\\f\\r \\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000\\ufeff]"
              }
            },
            "type": "object"
          },
          "included": {
            "type": "array",
            "maxItems": 0
          },
          "compressed": {
            "type": "array",
            "maxItems": 0
          }
        },
        "type": "object"
      },
      "else": {
        "properties": {
          "result": {
            "type": "object"
          },
          "refused": {
            "properties": {
              "reason": {
                "type": "null"
              }
            },
            "type": "object"
          }
        },
        "type": "object"
      }
    },
    {
      "if": {
        "properties": {
          "refused": {
            "type": "object",
            "properties": {
              "reason": {
                "const": "evidence_required"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "recovery": {
            "type": "object",
            "properties": {
              "action": {
                "enum": [
                  "retrieve_narrower",
                  "precompute_summary",
                  "request_context"
                ]
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "action"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "recovery"
        ]
      }
    }
  ]
}

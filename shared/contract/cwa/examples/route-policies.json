[
  {
    "route": "support-chat",
    "version": "illustrative/v1",
    "clock_skew_seconds": 5,
    "producers": {
      "policy-registry": {
        "kind": "policy",
        "slots": [
          "governance.instructions",
          "governance.examples",
          "governance.output_contract"
        ]
      },
      "capability-policy": {
        "kind": "capability_policy",
        "slots": [
          "governance.capabilities"
        ]
      },
      "state-svc": {
        "kind": "state",
        "slots": [
          "state.user",
          "state.task"
        ]
      },
      "policy-corpus": {
        "kind": "retrieval",
        "slots": [
          "evidence.knowledge"
        ]
      },
      "crm-mcp": {
        "kind": "mcp",
        "slots": [
          "evidence.tool_results"
        ]
      },
      "memory-svc": {
        "kind": "memory",
        "slots": [
          "interaction.memory"
        ]
      },
      "conversation": {
        "kind": "interaction",
        "slots": [
          "interaction.history",
          "interaction.query"
        ]
      }
    },
    "slots": {
      "state.user": {
        "max_age_seconds": 300,
        "required_scope": [
          "tenant",
          "user"
        ]
      },
      "state.task": {
        "max_age_seconds": 300,
        "required_scope": [
          "tenant",
          "task"
        ]
      },
      "evidence.knowledge": {
        "min_relevance": 0.5,
        "max_age_seconds": 7776000,
        "required_scope": [
          "tenant"
        ],
        "dedupe": "exact",
        "max_per_source": 3
      },
      "evidence.tool_results": {
        "supersede": "source"
      },
      "interaction.memory": {
        "source_prefix": "turn:",
        "required_scope": [
          "tenant",
          "user"
        ]
      }
    }
  },
  {

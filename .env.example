# Copy to .env at the repository root. Every lab runs without this file; with it, live paths send the rendered
# payload to an OpenAI-compatible endpoint. See docs/providers/openai-compatible.md.
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
CWA_WORKSHOP_MODEL=gpt-oss:20b
# Reasoning models: keep thinking short so reserved_output is not spent before the answer.
CWA_WORKSHOP_REASONING_EFFORT=low
# Server-specific request members, as JSON, sent as the request body's extra fields. Qwen3 on omlx or vLLM turns
# thinking off with this; servers that do not know the member ignore or reject it.
# CWA_WORKSHOP_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}

# Where the sibling repositories live. Default: the parent of this repository. See docs/setup.md.
# CWA_SIBLINGS_ROOT=/path/to/root

{
  "route": "account-help",
  "version": "w2/v1",
  "clock_skew_seconds": 5,
  "producers": {
    "app-policy": { "kind": "policy", "slots": ["governance.instructions"] },
    "accounts-db": { "kind": "state", "slots": ["state.user"] },
    "memory-store": { "kind": "memory", "slots": ["interaction.memory"] },
    "help-center-search": { "kind": "retrieval", "slots": ["evidence.knowledge"] },
    "chat-session": { "kind": "interaction", "slots": ["interaction.history", "interaction.query"] }
  },
  "slots": {
    "state.user": { "max_age_seconds": 300, "required_scope": ["tenant"] },
    "evidence.knowledge": { "min_relevance": 3.0, "required_scope": [], "dedupe": "exact", "max_per_source": 3, "order_by": ["-relevance", "-freshness"] },
    "interaction.memory": { "source_prefix": "turn:", "required_scope": ["tenant", "user"], "order_by": ["-freshness"] },
    "interaction.history": { "required_scope": ["session"], "order_by": ["-freshness"], "max_tokens": 300 },
    "interaction.query": { "required_scope": ["session"] }
  },
  "fitting_order": [
    { "slot": "interaction.history", "action": "omit" },
    { "slot": "evidence.knowledge", "action": "compress" },
    { "slot": "interaction.memory", "action": "omit" },
    { "slot": "evidence.knowledge", "action": "omit" }
  ]
}
